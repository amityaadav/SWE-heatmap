rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profile data: read-only public, writes only via backend (admin SDK bypasses rules)
    match /profile/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Topic catalog: read-only public, writes only via backend
    match /topic_catalog/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
