# Firebase client-side (NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin (server-side only, not needed on Cloud Run with ADC)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Ollama Cloud (server-side only)
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_API_URL=https://ollama.com/api/chat
OLLAMA_MODEL=deepseek-v4-pro:cloud

# Access control
ALLOWED_EMAILS=
